# Public feed endpoints.
SUBSTACK_FEED_URL=https://your-publication.substack.com/feed
MEDIUM_FEED_URL=https://medium.com/feed/@your-handle

# MongoDB-backed content studio. Never use NEXT_PUBLIC_ prefixes.
MONGODB_URI=
MONGODB_DB=rec_room
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Server-only HMAC secret for anonymous note rate limiting and reports.
# Generate independently from BETTER_AUTH_SECRET for production.
NOTE_ABUSE_SECRET=

# Realtime room presence. Keep both values server-only.
ABLY_API_KEY=
PRESENCE_ID_SECRET=
